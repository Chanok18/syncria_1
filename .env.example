# ====================
# SYNCRIA - Environment Variables
# ====================
# Copiar este archivo como .env y llenar los valores
# NUNCA commitear el archivo .env

# --------------------
# PostgreSQL
# --------------------
POSTGRES_PORT=5432
POSTGRES_DB=syncria_db
POSTGRES_USER=syncria_user
POSTGRES_PASSWORD=secret

# --------------------
# PGAdmin
# --------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@syncria.com
PGADMIN_DEFAULT_PASSWORD=admin

# --------------------
# Backend (Spring Boot)
# --------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=86400000

# Database Connection (para uso directo sin Docker)
DATABASE_URL=jdbc:postgresql://localhost:5432/syncria_db
DATABASE_USERNAME=syncria_user
DATABASE_PASSWORD=secret

# --------------------
# Frontend (React)
# --------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080

# --------------------
# n8n (Automations)
# --------------------
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=admin

# --------------------
# AI Services (Opcional)
# --------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# --------------------
# External Services
# --------------------
# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# S3 Storage (AWS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
